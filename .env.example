# Claude API — 운세 풀이 문장 생성 (Phase 3)
ANTHROPIC_API_KEY=

# Supabase Postgres — 프로필/일일 운세 캐시 (Phase 5)
DATABASE_URL=

# 커스텀 도메인 — 공유 미리보기(OG) 이미지의 절대 URL. 비우면 Vercel 배포 주소를 자동으로 쓴다
NEXT_PUBLIC_SITE_URL=

# 웹 푸시(매일 아침 알림) — 모두 비우면 알림 기능이 화면에서 숨겨진다
# VAPID 키 만들기: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://til-today-i-lucky.vercel.app
# Vercel Cron이 /api/cron/push를 부를 때 Authorization: Bearer 로 붙이는 비밀값
CRON_SECRET=
# 알림 구독 저장소 — Vercel Marketplace에서 Upstash for Redis를 연결하면 자동으로 들어온다
KV_REST_API_URL=
KV_REST_API_TOKEN=
